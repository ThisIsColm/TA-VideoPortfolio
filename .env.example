# Example Environment Variables for VideoPortfolio
# Copy this file to .env and fill in the values

# === API Server Settings ===
# API specific (if not using docker defaults)
PORT=3021
# Production vs development
NODE_ENV=development 
# Target for local CORS allowed origins
CORS_ORIGIN=http://localhost:5173

# === Database ===
DATABASE_URL=file:./database.sqlite3

# === Ghost CMS Headless Content Integration ===
# The URL of your Ghost Blog / CMS
GHOST_API_URL=https://your-ghost-blog.com
# Content API key with read access to Posts and Tags
GHOST_CONTENT_KEY=your_content_key_here
